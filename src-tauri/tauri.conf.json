{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiumaLauncher",
  "version": "0.6.2",
  "identifier": "dev.piuma.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PiumaLauncher",
        "width": 1360,
        "height": 860,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com https://launchercontent.mojang.com; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Lightweight Minecraft launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mrpack"
        ],
        "name": "Modrinth Modpack",
        "description": "Minecraft modpack",
        "mimeType": "application/x-modrinth-modpack+zip",
        "role": "Viewer"
      }
    ]
  }
}
